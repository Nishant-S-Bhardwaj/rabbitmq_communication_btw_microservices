# MongoDB URI shared by the user, captain, and ride services.
MONGO_URI=mongodb://127.0.0.1:27017/uber_clone

# Replace with a long, unique secret before using outside local development.
JWT_SECRET=replace-with-a-long-random-secret

# Local RabbitMQ AMQP connection.
RABBIT_URL=amqp://guest:guest@127.0.0.1:5672

# Gateway URL used by the ride service to authenticate users and captains.
BASE_URL=http://localhost:3000

# Shared token used only for captain-to-ride internal lifecycle requests.
INTERNAL_API_TOKEN=local-dev-internal-token

# Simulated driver capacity and trip timing (milliseconds).
DRIVER_WORKERS=3
PICKUP_DELAY_MS=5000
TRIP_DURATION_MS=15000
